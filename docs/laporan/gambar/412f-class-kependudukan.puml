@startuml 412f-class-kependudukan
' Gambar 4.n Class Diagram Kependudukan
' Sumber: src/lib/server/db/schema.ts (atribut) dan src/lib/server/*.ts (operasi).
' Render: java -jar plantuml.jar -tpng 412f-class-domain.puml
skinparam dpi 200
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12
skinparam roundCorner 0
skinparam ArrowColor #333333
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  HeaderBackgroundColor #E8EEF7
  StereotypeFontSize 10
}
skinparam nodesep 30
skinparam ranksep 45
hide empty members

class Rw {
  + id : int
  + nama : String
  + alamat : String
  + kelurahan : String
  + kecamatan : String
  + kota : String
}

class Rt {
  + id : int
  + nomor : int
}

class Pengurus {
  + id : int
  + jabatan : String
  + nama : String
  + fotoUrl : String
  + aktif : boolean
}

class Kk {
  + id : int
  + noKk : String
  + alamat : String
  + statusHuni : StatusHuni
}

class Warga {
  + id : int
  + nik : String
  + nama : String
  + tanggalLahir : Date
  + jenisKelamin : L | P
  + statusHubunganKk : String
  + aktif : boolean
  --
  + hitungUsia() : int
}

class PermintaanPembaruan {
  + id : int
  + dataLama : JSON
  + dataBaru : JSON
  + status : StatusPembaruan
  + ditinjauOleh : String
}

Rw "1" -- "1..*" Rt
Rw "1" -- "0..*" Pengurus
Rt "0..1" -- "0..*" Pengurus
Rt "1" -- "0..*" Kk
Kk "1" -- "1..*" Warga
Warga "1" -- "0..*" PermintaanPembaruan
@enduml
