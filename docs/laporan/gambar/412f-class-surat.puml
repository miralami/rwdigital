@startuml 412f-class-surat
' Gambar 4.n Class Diagram Surat dan Pengumuman
' Sumber: src/lib/server/db/schema.ts (atribut) dan src/lib/server/*.ts (operasi).
' Render: java -jar plantuml.jar -tpng 412f-class-domain.puml
skinparam dpi 200
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12
skinparam roundCorner 0
skinparam ArrowColor #333333
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  HeaderBackgroundColor #E8EEF7
  StereotypeFontSize 10
}
skinparam nodesep 30
skinparam ranksep 45
hide empty members

class Warga {
  + id : int
  + nik : String
  + nama : String
  + tanggalLahir : Date
  + jenisKelamin : L | P
  + statusHubunganKk : String
  + aktif : boolean
  --
  + hitungUsia() : int
}

class Surat {
  + id : int
  + nomorSurat : String
  + jenis : String
  + keperluan : String
  + status : StatusSurat
  + butuhTtdRt : boolean
  + butuhTtdRw : boolean
  --
  + dimintaTtd() : boolean
  + sudahTtd() : boolean
  + bolehMenandatangani() : boolean
}

class Rw {
  + id : int
  + nama : String
  + alamat : String
  + kelurahan : String
  + kecamatan : String
  + kota : String
}

class Rt {
  + id : int
  + nomor : int
}

class Pengumuman {
  + id : int
  + judul : String
  + isi : String
  + kategori : KategoriPengumuman
  + tanggalMulai : Date
  + tanggalSelesai : Date
  + ditampilkan : boolean
}

Rw "1" -- "1..*" Rt
Warga "1" -- "0..*" Surat
Rw "1" -- "0..*" Pengumuman
Rt "0..1" -- "0..*" Pengumuman
@enduml
