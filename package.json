		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@libsql/client": "^0.18.0",
		"@libsql/kysely-libsql": "^0.4.1",
		"@lucide/svelte": "^1.48.0",
		"@tailwindcss/vite": "^4.3.3",
		"better-auth": "^1.7.6",
		"drizzle-orm": "^0.45.3",
		"sveltekit-superforms": "^2.30.2",
		"tailwindcss": "^4.3.3",
