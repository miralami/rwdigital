{
	"name": "rwdigital",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"db:setup": "node scripts/db-setup.mts",
		"db:auth": "node scripts/db-auth.mts",
		"db:seed": "npx tsx scripts/seed.ts",
