# Database MySQL/MariaDB (XAMPP/Docker/hosting). Format: mysql://user:pass@host:port/nama_db
# Buat database + tabel: npm run db:setup  |  data contoh: npm run db:seed
DATABASE_URL=mysql://root@127.0.0.1:3306/rwdigital
BETTER_AUTH_SECRET=rahasia-capstone-rwdigital-super-secret-key-12345
BETTER_AUTH_URL=http://localhost:5173

# For login from a forwarded port, set the public origin shown on the other device:
# BETTER_AUTH_TRUSTED_ORIGINS=https://your-forwarded-host.example
# Multiple origins can be comma-separated. Do not include a path.

# Production: mysql://user:password@host:3306/rwdigital

# ─── Midtrans Payment Gateway ────────────────────────────────────────────────
# Dapatkan dari: https://dashboard.midtrans.com -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false
